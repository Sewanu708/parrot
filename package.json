{
  "name": "parrot",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "docker compose up -d && turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "db:generate": "pnpm --filter @parrot/db generate",
    "db:migrate": "pnpm --filter @parrot/db migrate",
    "db:push": "pnpm --filter @parrot/db push",
    "db:seed": "pnpm --filter @parrot/db seed",
    "db:studio": "pnpm --filter @parrot/db studio",
    "docker:down": "docker compose down",
    "prepare": "husky",
    "test": "exit 0"
  },
  "devDependencies": {
    "turbo": "^2.1.2"
  },
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.13.1",
      "onFail": "download"
    }
  },
  "type": "module",
  "dependencies": {
    "husky": "^9.1.7"
  }
}
